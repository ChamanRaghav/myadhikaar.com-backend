# Copy to .env for local development. On Railway, set these as service variables.

NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://myadhikaar:myadhikaar@localhost:5432/myadhikaar?schema=public"

# Website and API URLs
APP_URL=https://myadhikaar.com
API_URL=https://api.myadhikaar.com
# Comma-separated browser origins allowed to call the API (defaults to APP_URL)
CORS_ORIGINS=https://myadhikaar.com,https://www.myadhikaar.com,http://localhost:5173

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
# OAuth client ID from Google Cloud Console (Web application)
GOOGLE_CLIENT_ID=

# Email (Resend). Without a key, emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="MyAdhikaar <support@myadhikaar.com>"
# Comma-separated inboxes for admin notifications
ADMIN_EMAILS=support@myadhikaar.com,vishavjeetraghav61@gmail.com,adv.vishavjeetraghav@gmail.com

# Payments (Cashfree)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production (inferred from a TEST… app id when empty)
CASHFREE_ENV=

# Video calls (Daily.co), text-to-speech (ElevenLabs), AI (Anthropic)
DAILY_API_KEY=
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Uploads: any S3-compatible bucket (Cloudflare R2 recommended)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Scheduled jobs (billing ticks, payment reconciliation, reports) take a database lock,
# so they run once even with several replicas. Set to false to turn them off.
CRON_ENABLED=true
