// MyAdhikaar database schema.
//
// The models after "Entities" were converted from the Base44 entity
// definitions. Field names, IDs and timestamps are kept as they were in
// Base44 so migrated data and the frontend keep working unchanged.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Accounts & auth ─────────────────────────────────────────────────

model User {
  id                    String         @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Stored lowercase; the login identity for email codes and Google
  email                 String         @unique
  full_name             String?
  /// "admin" or "user"
  role                  String         @default("user")
  phone                 String?
  city                  String?
  notifications_enabled Boolean?
  avatar_url            String?
  /// Google account id, set on first Google sign-in
  google_sub            String?        @unique
  disabled              Boolean        @default(false)
  last_login_at         DateTime?      @db.Timestamptz(3)
  /// Extra attributes carried over from Base44
  data                  Json?
  created_date          DateTime       @default(now()) @db.Timestamptz(3)
  updated_date          DateTime       @default(now()) @updatedAt @db.Timestamptz(3)
  refresh_tokens        RefreshToken[]

  @@map("users")
}

model OtpCode {
  id           String    @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  email        String
  /// SHA-256 of the 6-digit code
  code_hash    String
  expires_at   DateTime  @db.Timestamptz(3)
  attempts     Int       @default(0)
  consumed_at  DateTime? @db.Timestamptz(3)
  ip           String?
  created_date DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, created_date])
  @@map("otp_codes")
}

model RefreshToken {
  id           String    @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  /// SHA-256 of the token; only the client ever holds the token itself
  token_hash   String    @unique
  /// Rotation family: reusing a rotated token revokes the whole family
  family_id    String
  expires_at   DateTime  @db.Timestamptz(3)
  revoked_at   DateTime? @db.Timestamptz(3)
  user_agent   String?
  ip           String?
  created_date DateTime  @default(now()) @db.Timestamptz(3)

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

// ── Payments ────────────────────────────────────────────────────────

model PaymentOrder {
  /// Cashfree order id, generated server-side (WLT…, SRV…, RGL…)
  id             String    @id
  user_email     String?
  /// wallet_recharge | service | rgl_subscription
  purpose        String
  /// Amount to charge, always computed server-side
  amount         Float
  currency       String    @default("INR")
  /// created | paid | failed | fulfilled
  status         String    @default("created")
  /// Whatever fulfilment needs (wallet credit and bonus, service request id, plan…)
  meta           Json?
  cf_payment_id  String?
  payment_method String?
  paid_at        DateTime? @db.Timestamptz(3)
  fulfilled_at   DateTime? @db.Timestamptz(3)
  created_date   DateTime  @default(now()) @db.Timestamptz(3)
  updated_date   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([user_email])
  @@index([status])
  @@map("payment_orders")
}

// ── AI assistant ────────────────────────────────────────────────────

model AgentConversation {
  id           String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  agent_name   String
  user_email   String?
  metadata     Json?
  /// [{ role, content, created_date }]
  messages     Json     @default("[]")
  created_date DateTime @default(now()) @db.Timestamptz(3)
  updated_date DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([user_email])
  @@map("agent_conversations")
}

// ── Uploads ─────────────────────────────────────────────────────────

model FileUpload {
  id           String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  key          String   @unique
  url          String
  content_type String?
  size         Int?
  uploaded_by  String?
  created_date DateTime @default(now()) @db.Timestamptz(3)

  @@map("file_uploads")
}

// ── Entities (converted from Base44) ────────────────────────────────

model Blog {
  id                String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Blog post title
  title             String?
  /// URL-friendly slug
  slug              String?
  /// Blog category — One of: legal_services, case_study, compliance, roadguard, consumer_rights, business_law
  category          String?
  /// Short summary shown in listings
  excerpt           String?
  /// Full blog post content (HTML or markdown)
  content           String?
  /// Cover image URL
  cover_image       String?
  /// Author name
  author_name       String?
  /// SEO tags and keywords
  tags              Json?
  /// Whether blog is visible to public
  is_published      Boolean? @default(false)
  /// Show in featured section
  is_featured       Boolean? @default(false)
  /// Estimated read time
  read_time_minutes Float?
  /// SEO meta description (150-160 chars recommended)
  meta_description  String?
  /// Comma-separated SEO keywords for this post
  meta_keywords     String?
  /// Target city for geo-SEO e.g. Delhi, Mumbai
  geo_city          String?
  /// Target state e.g. Delhi, Maharashtra
  geo_state         String?
  /// Target country
  geo_country       String?  @default("India")
  /// ISO 3166-2 region code e.g. IN-DL for Delhi
  geo_region        String?
  /// Primary SEO keyword / keyphrase for this post
  focus_keyword     String?
  /// Number of times this post has been viewed
  view_count        Float?   @default(0)
  created_date      DateTime @default(now()) @db.Timestamptz(3)
  updated_date      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by        String?
  created_by_id     String?

  @@index([slug])
  @@index([created_date])
  @@map("blogs")
}

model Case {
  id                   String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Auto-generated unique case ID
  case_id              String?
  /// Client's email
  client_email         String?
  /// Client's full name
  client_name          String?
  /// Case title
  title                String?
  /// Case description / problem statement
  description          String?
  /// Case category — One of: criminal, domestic_violence, bail, high_court, supreme_court, pil, civil, family, property, labour, consumer, other
  category             String?
  /// Court level — One of: trial, sessions, high_court, supreme_court, tribunal, other
  court_level          String?
  /// Current case status — One of: pending, active, in_review, filed, listed, disposed, completed, cancelled
  status               String?  @default("pending")
  /// Filing stage — One of: drafted, filed, listed, disposed
  filing_status        String?
  /// Case health indicator — One of: green, amber, red
  health_status        String?  @default("green")
  /// Limitation/deadline date — Format: date
  limitation_date      String?
  /// Next scheduled hearing date — Format: date
  next_hearing_date    String?
  /// Assigned lawyer ID
  assigned_lawyer_id   String?
  /// Assigned lawyer name
  assigned_lawyer_name String?
  /// Amount paid in INR
  amount_paid          Float?
  /// Agreed fee in INR
  fee_agreed           Float?
  /// Internal notes
  notes                String?
  /// AI-generated summary of the case
  ai_summary           String?
  /// List of missing documents flagged by AI
  missing_documents    Json?
  /// Case tags
  tags                 Json?
  created_date         DateTime @default(now()) @db.Timestamptz(3)
  updated_date         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by           String?
  created_by_id        String?

  @@index([case_id])
  @@index([client_email])
  @@index([status])
  @@index([assigned_lawyer_id])
  @@index([created_date])
  @@map("cases")
}

model CaseDocument {
  id                String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Reference to Case entity ID
  case_id           String?
  /// Document name
  name              String?
  /// Document folder/category — One of: fir, orders, affidavits, pleadings, evidence, correspondence, certified_copies, other
  folder            String?
  /// Version label e.g. Draft v1, Final
  version           String?
  /// URL of the uploaded file
  file_url          String?
  /// AI-generated summary of this document
  ai_summary        String?
  /// Email of uploader
  uploaded_by       String?
  /// Is this a certified copy?
  is_certified_copy Boolean? @default(false)
  /// Optional description or notes about this document
  description       String?
  created_date      DateTime @default(now()) @db.Timestamptz(3)
  updated_date      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by        String?
  created_by_id     String?

  @@index([case_id])
  @@index([created_date])
  @@map("case_documents")
}

model ChatMessage {
  id              String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Unique ID for the conversation: lawyer_id + '_' + user_email
  conversation_id String?
  /// Sender's email
  sender_email    String?
  /// Sender's display name
  sender_name     String?
  /// Role of sender — One of: user, advocate
  sender_role     String?
  /// Text message content
  content         String?
  /// URL of attached file/image/video
  file_url        String?
  /// Original file name
  file_name       String?
  /// MIME type of the file
  file_type       String?
  /// Whether the message has been read
  is_read         Boolean? @default(false)
  /// Lawyer ID in this conversation
  lawyer_id       String?
  /// User email in this conversation
  user_email      String?
  created_date    DateTime @default(now()) @db.Timestamptz(3)
  updated_date    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by      String?
  created_by_id   String?

  @@index([sender_email])
  @@index([lawyer_id])
  @@index([user_email])
  @@index([created_date])
  @@map("chat_messages")
}

model Consultation {
  id                String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Client's email
  client_email      String?
  /// Client's name
  client_name       String?
  /// ID of the assigned lawyer
  lawyer_id         String?
  /// Name of the lawyer
  lawyer_name       String?
  /// Consultation status — One of: scheduled, in_progress, completed, cancelled
  status            String?  @default("scheduled")
  /// Scheduled date and time — Format: date-time
  scheduled_date    String?
  /// Duration in minutes
  duration_minutes  Float?
  /// Amount paid in INR
  amount_paid       Float?
  /// Consultation notes
  notes             String?
  /// Type of consultation — One of: audio, video
  consultation_type String?
  created_date      DateTime @default(now()) @db.Timestamptz(3)
  updated_date      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by        String?
  created_by_id     String?

  @@index([client_email])
  @@index([lawyer_id])
  @@index([status])
  @@index([created_date])
  @@map("consultations")
}

model Dispute {
  id              String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Email of person raising dispute
  raised_by_email String?
  /// Name of person raising dispute
  raised_by_name  String?
  /// Who is raising the dispute — One of: user, advocate
  raised_by_role  String?
  /// Dispute type — One of: wrong_deduction, payment_not_received, late_settlement, duplicate_charge, service_quality, advocate_misconduct, other
  type            String?
  /// Amount in dispute (INR)
  amount          Float?
  /// Detailed description
  description     String?
  /// Related lawyer ID if any
  lawyer_id       String?
  /// Related lawyer name
  lawyer_name     String?
  /// Related consultation ID if any
  consultation_id String?
  /// Dispute status — One of: open, under_review, resolved, rejected
  status          String?  @default("open")
  /// Admin resolution notes
  admin_notes     String?
  /// Admin who resolved
  resolved_by     String?
  /// Amount refunded if any
  refund_amount   Float?
  created_date    DateTime @default(now()) @db.Timestamptz(3)
  updated_date    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by      String?
  created_by_id   String?

  @@index([raised_by_email])
  @@index([lawyer_id])
  @@index([consultation_id])
  @@index([status])
  @@index([created_date])
  @@map("disputes")
}

model Escalation {
  id               String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Reference to Case ID
  case_id          String?
  /// Client who raised escalation
  client_email     String?
  /// Client name
  client_name      String?
  /// Lawyer against whom escalation is raised
  lawyer_id        String?
  /// Lawyer name
  lawyer_name      String?
  /// Escalation type — One of: non_responsive, case_review, senior_counsel, misconduct, other
  type             String?
  /// Escalation details
  description      String?
  /// Escalation severity level — One of: level_1, level_2, level_3
  level            String?  @default("level_1")
  /// Escalation status — One of: open, in_review, resolved, escalated
  status           String?  @default("open")
  /// Admin resolution notes
  resolution_notes String?
  /// Admin who resolved
  resolved_by      String?
  created_date     DateTime @default(now()) @db.Timestamptz(3)
  updated_date     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by       String?
  created_by_id    String?

  @@index([case_id])
  @@index([client_email])
  @@index([lawyer_id])
  @@index([status])
  @@index([created_date])
  @@map("escalations")
}

model FleetDriver {
  id                      String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// FleetOwner entity ID
  fleet_owner_id          String?
  /// Owner's email
  owner_email             String?
  /// Policy number
  policy_number           String?
  /// Driver full name
  name                    String?
  /// Phone number
  phone                   String?
  /// Email if available
  email                   String?
  /// Driving licence number
  dl_number               String?
  /// DL expiry date — Format: date
  dl_expiry               String?
  /// Residential address
  address                 String?
  /// Emergency contact number
  emergency_contact       String?
  /// FleetVehicle entity ID
  assigned_vehicle_id     String?
  /// Vehicle registration number
  assigned_vehicle_number String?
  /// One of: active, inactive, suspended
  status                  String?  @default("active")
  /// Admin notes
  notes                   String?
  created_date            DateTime @default(now()) @db.Timestamptz(3)
  updated_date            DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by              String?
  created_by_id           String?

  @@index([fleet_owner_id])
  @@index([owner_email])
  @@index([policy_number])
  @@index([email])
  @@index([status])
  @@index([created_date])
  @@map("fleet_drivers")
}

model FleetInvoice {
  id                 String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// e.g. INV-2026-0001
  invoice_number     String?
  /// Policy number
  policy_number      String?
  /// FleetOwner entity ID
  fleet_owner_id     String?
  /// Fleet owner name
  owner_name         String?
  /// Fleet owner email
  owner_email        String?
  /// Fleet owner phone
  owner_phone        String?
  /// Company name
  company_name       String?
  /// Plan purchased e.g. Intercity Growth
  plan               String?
  /// Number of vehicles
  vehicle_count      Float?
  /// Amount paid in INR
  amount             Float?
  /// GST (18%) in INR
  gst_amount         Float?
  /// Total incl. GST
  total_amount       Float?
  /// PayU transaction ID
  transaction_id     String?
  /// e.g. UPI, Card, NetBanking
  payment_method     String?
  /// Payment date — Format: date
  payment_date       String?
  /// Format: date
  subscription_start String?
  /// Format: date
  subscription_end   String?
  /// One of: paid, pending, failed, refunded
  status             String?  @default("paid")
  /// URL to generated PDF invoice
  pdf_url            String?
  email_sent         Boolean? @default(false)
  notes              String?
  created_date       DateTime @default(now()) @db.Timestamptz(3)
  updated_date       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by         String?
  created_by_id      String?

  @@index([policy_number])
  @@index([fleet_owner_id])
  @@index([owner_email])
  @@index([status])
  @@index([created_date])
  @@map("fleet_invoices")
}

model FleetOwner {
  id                 String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Email of the fleet owner (matched with User)
  user_email         String?
  owner_name         String?
  /// RoadGuard policy number
  policy_number      String?
  company_name       String?
  phone              String?
  /// GST registration number
  gst_number         String?
  /// Registered address
  address            String?
  /// Total vehicles in fleet
  fleet_size         Float?
  /// One of: cab, lcv, truck, bus, mixed
  vehicle_type       String?
  /// One of: starter, growth, premium
  plan               String?  @default("starter")
  /// Intercity or Pan-India — One of: intercity, pan_india
  service_type       String?  @default("pan_india")
  /// One of: active, suspended, expired
  status             String?  @default("active")
  /// Format: date
  policy_start       String?
  /// Format: date
  policy_end         String?
  /// Current subscription start — Format: date
  subscription_start String?
  /// Current subscription expiry — Format: date
  subscription_end   String?
  /// Latest FleetInvoice ID
  last_invoice_id    String?
  /// Admin email who assigned
  assigned_by_admin  String?
  notes              String?
  created_date       DateTime @default(now()) @db.Timestamptz(3)
  updated_date       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by         String?
  created_by_id      String?

  @@index([user_email])
  @@index([policy_number])
  @@index([status])
  @@index([created_date])
  @@map("fleet_owners")
}

model FleetVehicle {
  id                   String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// FleetOwner entity ID
  fleet_owner_id       String?
  /// Owner's email
  owner_email          String?
  /// Policy number
  policy_number        String?
  /// Registration number e.g. DL01AB1234
  vehicle_number       String?
  /// Vehicle type — One of: cab, lcv, truck, bus, other
  vehicle_type         String?
  /// e.g. Tata Ace, Ashok Leyland
  make_model           String?
  /// Manufacturing year
  year                 Float?
  /// RC expiry date — Format: date
  rc_expiry            String?
  /// PUC expiry date — Format: date
  puc_expiry           String?
  /// Fitness certificate expiry — Format: date
  fitness_expiry       String?
  /// Insurance expiry — Format: date
  insurance_expiry     String?
  /// Permit expiry — Format: date
  permit_expiry        String?
  /// FleetDriver entity ID
  assigned_driver_id   String?
  /// Driver name
  assigned_driver_name String?
  /// Current legal status — One of: clear, case_active, challan_pending, vehicle_seized
  legal_status         String?  @default("clear")
  /// RGLCase ID if any
  active_case_id       String?
  /// Admin notes
  notes                String?
  is_active            Boolean? @default(true)
  created_date         DateTime @default(now()) @db.Timestamptz(3)
  updated_date         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by           String?
  created_by_id        String?

  @@index([fleet_owner_id])
  @@index([owner_email])
  @@index([policy_number])
  @@index([created_date])
  @@map("fleet_vehicles")
}

model Hearing {
  id                  String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Reference to Case entity ID
  case_id             String?
  /// Scheduled hearing date & time — Format: date-time
  hearing_date        String?
  /// Name of the court
  court_name          String?
  /// Name of the judge
  judge_name          String?
  /// Outcome / order passed
  outcome             String?
  /// Next date given by court — Format: date
  next_date           String?
  /// Hearing status — One of: upcoming, completed, adjourned, cancelled
  status              String?  @default("upcoming")
  /// Whether order has been uploaded
  order_uploaded      Boolean? @default(false)
  /// URL of uploaded order document
  order_url           String?
  /// Hearing notes
  notes               String?
  /// Compliance deadline arising from this hearing — Format: date
  compliance_deadline String?
  created_date        DateTime @default(now()) @db.Timestamptz(3)
  updated_date        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by          String?
  created_by_id       String?

  @@index([case_id])
  @@index([status])
  @@index([created_date])
  @@map("hearings")
}

model HeroBanner {
  id            String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Slide title (optional)
  title         String?
  /// Slide subtitle text
  subtitle      String?
  /// Banner image URL (16:9 recommended)
  image_url     String?
  /// CTA button label
  cta_label     String?
  /// CTA button link (page path)
  cta_link      String?
  /// Display order (lower = first)
  order         Float?
  /// Whether the slide is visible
  is_active     Boolean? @default(true)
  /// Cannot be deleted or edited (first slide)
  is_fixed      Boolean? @default(false)
  /// Optional description or internal notes about this banner
  description   String?
  created_date  DateTime @default(now()) @db.Timestamptz(3)
  updated_date  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by    String?
  created_by_id String?

  @@index([created_date])
  @@map("hero_banners")
}

model JobApplication {
  id              String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// JobOpening entity ID
  job_id          String?
  job_title       String?
  applicant_name  String?
  applicant_email String?
  applicant_phone String?
  /// Uploaded resume URL
  resume_url      String?
  cover_letter    String?
  /// Answers to admin-defined custom fields
  custom_answers  Json?
  /// One of: applied, under_review, shortlisted, interview_scheduled, on_hold, hired, rejected, duplicate
  status          String?  @default("applied")
  /// Internal notes, tags [TAG:...], and activity log — not shown to candidate
  admin_notes     String?
  /// Format: date-time
  interview_date  String?
  reviewed_by     String?
  reject_reason   String?
  /// Optional description or additional context for this job application
  description     String?
  created_date    DateTime @default(now()) @db.Timestamptz(3)
  updated_date    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by      String?
  created_by_id   String?

  @@index([applicant_email])
  @@index([status])
  @@index([created_date])
  @@map("job_applications")
}

model JobOpening {
  id            String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Job title
  title         String?
  /// Department — One of: legal, technology, marketing, operations, content, hr, rgl
  department    String?
  /// City / Remote
  location      String?
  /// One of: full_time, part_time, internship, contract
  type          String?  @default("full_time")
  /// Full job description
  description   String?
  /// Requirements list
  requirements  String?
  /// e.g. ₹4–6 LPA
  salary_range  String?
  is_active     Boolean? @default(true)
  /// Admin-defined form fields: [{label, type, required}]
  custom_fields Json?
