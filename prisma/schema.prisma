model RGLReferral {
  id                String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Email of the referrer
  user_email        String?
  user_name         String?
  /// Unique code e.g. REF-RAMESH-001
  referral_code     String?
  is_active         Boolean? @default(true)
  total_referrals   Float?   @default(0)
  /// Total commission earned in INR
  total_earned      Float?   @default(0)
  /// Withdrawable balance
  available_balance Float?   @default(0)
  total_withdrawn   Float?   @default(0)
  /// Optional notes about this referral account
  description       String?
  created_date      DateTime @default(now()) @db.Timestamptz(3)
  updated_date      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by        String?
  created_by_id     String?

  @@index([user_email])
  @@index([referral_code])
  @@index([created_date])
  @@map("rgl_referrals")
}

model RGLSubscription {
  id                  String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Unique RGL policy number e.g. RGL-2026-0001
  policy_number       String?
  buyer_name          String?
  buyer_email         String?
  buyer_phone         String?
  fleet_size          Float?
  vehicle_type        String?
  city                String?
  /// e.g. Kavach Starter, Kavach Growth, Kavach Premium
  plan_name           String?
  /// One of: intercity, pan_india
  plan_type           String?
  amount_paid         Float?
  discount_amount     Float?   @default(0)
  /// Promo/referral code entered by buyer
  referral_code_used  String?
  /// Email of person who referred
  referrer_email      String?
  /// 15% commission credited to referrer
  referral_commission Float?   @default(0)
  txn_id              String?
  /// Format: date
  payment_date        String?
  /// 24-48h after payment — Format: date
  activation_date     String?
  /// 1 year from activation — Format: date
  expiry_date         String?
  /// Whether to auto-renew on expiry
  auto_renewal        Boolean? @default(true)
  /// One of: pending, active, expired, cancelled
  status              String?  @default("active")
  invoice_url         String?
  notes               String?
  created_date        DateTime @default(now()) @db.Timestamptz(3)
  updated_date        DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by          String?
  created_by_id       String?

  @@index([policy_number])
  @@index([buyer_email])
  @@index([referrer_email])
  @@index([txn_id])
  @@index([status])
  @@index([created_date])
  @@map("rgl_subscriptions")
}

model RGLWithdrawal {
  id             String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  referrer_email String?
  referrer_name  String?
  referral_code  String?
  amount         Float?
  account_holder String?
  account_number String?
  ifsc_code      String?
  bank_name      String?
  upi_id         String?
  /// One of: pending, approved, paid, rejected
  status         String?  @default("pending")
  admin_notes    String?
  /// Optional notes or reason for this withdrawal request
  description    String?
  created_date   DateTime @default(now()) @db.Timestamptz(3)
  updated_date   DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by     String?
  created_by_id  String?

  @@index([referrer_email])
  @@index([referral_code])
  @@index([status])
  @@index([created_date])
  @@map("rgl_withdrawals")
}

model ServiceCase {
  id                   String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Client's email
  client_email         String?
  /// Client's name
  client_name          String?
  /// ID of the legal service
  service_id           String?
  /// Title of the service
  service_title        String?
  /// Case status — One of: pending, active, in_review, completed, cancelled
  status               String?  @default("pending")
  /// Amount paid
  amount_paid          Float?
  /// Assigned lawyer ID
  assigned_lawyer_id   String?
  /// Assigned lawyer name
  assigned_lawyer_name String?
  /// Uploaded document URLs
  documents            Json?
  /// Case notes
  notes                String?
  created_date         DateTime @default(now()) @db.Timestamptz(3)
  updated_date         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by           String?
  created_by_id        String?

  @@index([client_email])
  @@index([status])
  @@index([assigned_lawyer_id])
  @@index([created_date])
  @@map("service_cases")
}

model ServiceRequest {
  id                   String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Client's email
  client_email         String?
  /// Client's full name
  client_name          String?
  /// Client's phone number
  client_phone         String?
  /// ID of the legal service
  service_id           String?
  /// Title of the service
  service_title        String?
  /// Service category
  category             String?
  /// Selected package name
  package_name         String?
  /// Selected package price string
  package_price        String?
  /// Amount paid in INR
  amount_paid          Float?
  /// Human-readable SR number e.g. SR-2026-00042
  service_request_no   String?
  /// Cashfree order ID
  payment_order_id     String?
  /// One of: pending, paid, failed
  payment_status       String?  @default("pending")
  /// Client's problem/matter description
  description          String?
  /// Uploaded document URLs
  documents            Json?
  /// One of: pending, uploaded
  doc_upload_status    String?  @default("pending")
  /// One of: pending, in_review, assigned, completed, cancelled
  status               String?  @default("pending")
  assigned_lawyer_id   String?
  assigned_lawyer_name String?
  notes                String?
  price_quoted         Float?
  created_date         DateTime @default(now()) @db.Timestamptz(3)
  updated_date         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by           String?
  created_by_id        String?

  @@index([client_email])
  @@index([payment_order_id])
  @@index([status])
  @@index([assigned_lawyer_id])
  @@index([created_date])
  @@map("service_requests")
}

model Session {
  id               String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// User's email
  user_email       String?
  /// Lawyer entity ID
  lawyer_id        String?
  /// Lawyer name
  lawyer_name      String?
  /// Linked consultation ID
  consultation_id  String?
  /// Type of session — One of: call, chat
  session_type     String?
  /// Session status — One of: active, ended, expired
  status           String?  @default("active")
  /// Rate per minute in INR
  rate_per_min     Float?
  /// Session start time — Format: date-time
  started_at       String?
  /// Session end time — Format: date-time
  ended_at         String?
  /// Total billed minutes
  duration_minutes Float?   @default(0)
  /// Total amount charged
  total_charged    Float?   @default(0)
  /// Last time a tick deduction was made — Format: date-time
  last_tick_at     String?
  /// Unique key to prevent duplicate session creation (user_email-lawyer_id-consultation_id)
  idempotency_key  String?
  /// Optional notes about this session
  description      String?
  created_date     DateTime @default(now()) @db.Timestamptz(3)
  updated_date     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by       String?
  created_by_id    String?

  @@index([user_email])
  @@index([lawyer_id])
  @@index([consultation_id])
  @@index([status])
  @@index([created_date])
  @@map("sessions")
}

model Wallet {
  id              String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// User email
  user_email      String?
  /// Available balance in INR
  balance         Float?   @default(0)
  /// Bonus credit balance
  bonus_balance   Float?   @default(0)
  total_recharged Float?   @default(0)
  total_spent     Float?   @default(0)
  /// Optional notes about this wallet
  description     String?
  created_date    DateTime @default(now()) @db.Timestamptz(3)
  updated_date    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by      String?
  created_by_id   String?

  @@index([user_email])
  @@index([created_date])
  @@map("wallets")
}

model WalletTransaction {
  id               String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  user_email       String?
  /// Transaction type — One of: topup, deduction, refund, bonus
  type             String?
  /// Transaction amount in INR
  amount           Float?
  gst              Float?   @default(0)
  net_amount       Float?
  description      String?
  lawyer_name      String?
  consultation_id  String?
  duration_minutes Float?
  rate_per_min     Float?
  /// One of: completed, processing, failed
  status           String?  @default("completed")
  payment_method   String?
  /// Order/payment ID for idempotency — prevents duplicate credits
  reference_id     String?
  created_date     DateTime @default(now()) @db.Timestamptz(3)
  updated_date     DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by       String?
  created_by_id    String?

  @@index([user_email])
  @@index([consultation_id])
  @@index([status])
  @@index([reference_id])
  @@index([created_date])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id              String   @id @default(dbgenerated("substr(replace((gen_random_uuid())::text, '-'::text, ''::text), 1, 24)"))
  /// Lawyer entity ID
  lawyer_id       String?
  /// Lawyer full name
  lawyer_name     String?
  /// Lawyer email
  lawyer_email    String?
  /// Requested withdrawal amount in INR
  amount          Float?
  /// Withdrawal method — One of: upi, bank
  method          String?
  /// UPI ID if method is UPI
  upi_id          String?
  /// Bank account holder name
  account_holder  String?
  /// Bank account number
  account_number  String?
  /// IFSC code
  ifsc_code       String?
  /// Bank name
  bank_name       String?
  /// Request status — One of: pending, approved, paid, rejected
  status          String?  @default("pending")
  /// Admin notes
  admin_notes     String?
  /// Admin email who processed
  processed_by    String?
  /// When processed — Format: date-time
  processed_at    String?
  /// Payment reference / UTR number
  transaction_ref String?
  /// Optional description or reason for this withdrawal request
  description     String?
  created_date    DateTime @default(now()) @db.Timestamptz(3)
  updated_date    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  created_by      String?
  created_by_id   String?

  @@index([lawyer_id])
  @@index([lawyer_email])
  @@index([status])
  @@index([created_date])
  @@map("withdrawal_requests")
}
